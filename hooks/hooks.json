{
  "description": "HeadCanon: inject the canon's rules, state and tree at the start of every session.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/packages/canon/bin/headcanon.js", "session-start"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
