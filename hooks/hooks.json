{
  "description": "HeadCanon: inject the canon's rules, state and tree at the start of every session; hold an attending session and an implementation agent to their stop rules; mirror the terminal into the page.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/packages/canon/bin/headcanon.js", "stop-hook"],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/packages/canon/bin/headcanon.js", "gate", "subagent-stop"],
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/packages/canon/bin/headcanon.js", "prompt-hook"],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/packages/canon/bin/headcanon.js", "session-start"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
